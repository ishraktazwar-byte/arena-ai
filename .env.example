MC_HOST=Rayan_609.aternos.me
MC_PORT=25565
MC_VERSION=1.21.1
# Keep stable across DynIP changes; change after a world reset or for another world.
MC_WORLD_ID=arena-world-1
# Set explicitly after confirming server authentication: microsoft or offline
MC_AUTH=
# For Microsoft auth, set the account username locally; cached tokens stay in runtime/.
MC_USERNAME=
AGENT_AI_INTERVAL_MS=300000
# Cloud planning is opt-in. Requests always use openrouter/free; no paid fallback.
AI_ENABLED=false
# Shared across agents launched from this project directory, including retries.
AI_DAILY_REQUEST_LIMIT=24
OPENROUTER_API_KEY=

# Destructive tools stay disabled until an owner-approved empty mining area is set.
MC_MINING_ENABLED=false
MC_MINING_DIMENSION=overworld
# Six integer bounds: minX,minY,minZ,maxX,maxY,maxZ. No default area is authorized.
MC_MINING_AREA=

# Separate permission for crafting-table placement/use. Does not enable mining.
MC_WORKSPACE_ENABLED=false
MC_WORKSPACE_DIMENSION=overworld
# Owner-approved bounds: minX,minY,minZ,maxX,maxY,maxZ. Empty means no authorized area.
MC_WORKSPACE_AREA=

# Independent pickup permission: ownership of dropped items is not observable.
MC_COLLECTION_ENABLED=false
MC_COLLECTION_DIMENSION=overworld
# Owner-approved bounds at feet/drop level; never inherits mining/workspace area.
MC_COLLECTION_AREA=

# Independent permission for bounded known-terrain local navigation only.
# Does not authorize mining/collection or constrain emergency survival movement.
MC_NAVIGATION_ENABLED=false
MC_NAVIGATION_DIMENSION=overworld
MC_NAVIGATION_AREA=
